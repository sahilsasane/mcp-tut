        {
            "name": "ResponseAgent",
            "role": "Generate user-facing response using model + grounding context",
            "model": "Mistral 7B fine-tuned variant",
            "runtime": "Python 3.10"
        }
    ],
    "apis": [
        {
            "endpoint": "/agent/deploy",
            "method": "POST",
            "input_example": {
                "agent_id": "response-agent-v2",
                "env": "staging",
                "config": {
                    "threads": 4,
                    "max_concurrency": 10
                }
